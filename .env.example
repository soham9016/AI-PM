# Required
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional — Cerebras is used for a few large-payload LLM calls (see
# config.py's MODELS). If this is left empty, those calls silently fall
# back to Groq, logged, not an error.
CEREBRAS_API_KEY=

# Optional — search provider selection (see tools/search.py). "tavily"
# is the only implementation today; add a new provider function + entry
# in tools/search.py's _PROVIDERS to support another one.
SEARCH_PROVIDER=tavily
